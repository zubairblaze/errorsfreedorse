---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; path: string; description: string; updated: string; }
const { title, path, description, updated } = Astro.props;
---
<BaseLayout title={title} path={path} description={description}>
  <PageHero eyebrow="Legal" title={title} lede={description} />
  <section class="section" style="padding-top:0">
    <div class="shell">
      <p class="legal__updated mono">Last updated: {updated}</p>
      <div class="legal"><slot /></div>
      <aside class="legal__notice card">
        <p>
          <strong>Note for review.</strong> This document is a working draft prepared alongside the
          site build. Have it reviewed against your final entity details, licence jurisdiction and
          UAE data-protection obligations before the site goes live.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .legal__updated { font-size: var(--t-xs); color: var(--ink-3); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--s-6); }
  .legal { max-width: 44rem; color: var(--ink-2); font-size: var(--t-base); line-height: 1.75; }
  .legal :global(h2) { font-size: var(--t-xl); color: var(--ink); margin-top: 2em; margin-bottom: 0.6em; padding-top: 0.9em; border-top: 1px solid var(--line); }
  .legal :global(h2:first-of-type) { margin-top: 0; padding-top: 0; border-top: 0; }
  .legal :global(p) { margin-bottom: 1em; }
  .legal :global(ul) { margin: 0 0 1.2em; padding-inline-start: 1.4em; display: grid; gap: 0.5em; }
  .legal :global(li)::marker { color: var(--accent); }
  .legal :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal__notice { max-width: 44rem; margin-top: var(--s-7); font-size: var(--t-sm); color: var(--ink-2); }
  .legal__notice strong { color: var(--ink); }
</style>
