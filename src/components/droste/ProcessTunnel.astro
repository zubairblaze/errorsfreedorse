---
/**
 * "Our Process" as a scroll-driven Droste tunnel.
 *
 * The section pins for three screens; scrolling flies you through frames
 * labelled Build → Test → Refine → Repeat → Build, each one nested inside
 * the last. Because the frames recycle, arriving at Repeat drops you back
 * into Build — the loop is the visual, not an illustration of it.
 *
 * Pinning is desktop-only and reduced-motion-only-if-allowed. Everywhere
 * else the same four steps render as a plain list, which is what the
 * screen reader gets regardless.
 */
import DrosteZoom from './DrosteZoom.astro';
import { processSteps } from '../../data/process.ts';
---

<!-- Tall wrapper provides the scroll distance; the sticky child is what you
     actually look at. Height is set in CSS so the no-JS layout is sane. -->
<div class="tunnel" data-droste-pin data-process-tunnel>
  <div class="tunnel__sticky">
    <div class="tunnel__inner shell-wide">
      <div class="tunnel__copy">
        <p class="eyebrow">The loop</p>
        <ol class="tunnel__steps">
          {processSteps.map((s, i) => (
            <li class="tunnel__step" data-step={i}>
              <span class="tunnel__n mono">{s.n}</span>
              <span class="tunnel__text">
                <span class="tunnel__title">{s.title}</span>
                <span class="tunnel__body">{s.body}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="tunnel__hint mono" aria-hidden="true">
          <span class="tunnel__bar"><span class="tunnel__bar-fill"></span></span>
          keep scrolling
        </p>
      </div>

      <div class="tunnel__viz">
        <DrosteZoom
          levels={8} ratio={0.68} rotate={6.5}
          driver="pin" span={4} variant="steps" drift={0}
        />
      </div>
    </div>
  </div>
</div>

<style>
  .tunnel { position: relative; }
  .tunnel__sticky { position: sticky; top: 0; min-height: 100svh; display: grid; align-items: center; }
  .tunnel__inner {
    display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center;
    padding-block: var(--s-7);
  }

  /* Pinning only where there is room for it. Below this width the wrapper
     collapses to its content height and the section scrolls normally. */
  @media (min-width: 980px) {
    .tunnel { height: 300svh; }
    .tunnel__inner { grid-template-columns: 1fr 1.05fr; }
  }
  @media (max-width: 979px) {
    .tunnel__sticky { position: static; min-height: 0; }
  }

  .tunnel__steps { list-style: none; margin: var(--s-5) 0 0; padding: 0; display: grid; gap: var(--s-2); }
  .tunnel__step {
    display: flex; gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-3);
    border: 1px solid transparent;
    opacity: 0.45;
    transition: opacity var(--dur-3) var(--ease-out), background-color var(--dur-3) var(--ease-out),
                border-color var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .tunnel__step[data-on] {
    opacity: 1;
    background: var(--bg-2);
    border-color: var(--line);
    transform: translateX(6px);
  }
  .tunnel__n { font-size: var(--t-xs); color: var(--ink-3); padding-top: 0.35em; flex: none; letter-spacing: 0.08em; }
  .tunnel__step[data-on] .tunnel__n { color: var(--accent); }
  .tunnel__title {
    display: block; font-family: var(--font-display); font-weight: 600;
    font-size: var(--t-lg); letter-spacing: -0.02em; color: var(--ink); margin-bottom: 0.25em;
  }
  .tunnel__body { display: block; color: var(--ink-2); font-size: var(--t-sm); line-height: 1.6; }

  .tunnel__hint {
    display: flex; align-items: center; gap: 0.8em;
    margin-top: var(--s-5);
    font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3);
  }
  .tunnel__bar { display: block; width: 90px; height: 2px; background: var(--line-2); border-radius: 2px; overflow: hidden; }
  .tunnel__bar-fill { display: block; height: 100%; width: 0%; background: var(--accent); transition: width 120ms linear; }

  .tunnel__viz {
    position: relative;
    aspect-ratio: 1 / 1;
    max-height: 74svh;
    margin-inline: auto;
    width: 100%;
    overflow: hidden;
    mask-image: radial-gradient(circle at 50% 50%, #000 60%, transparent 96%);
  }

  @media (max-width: 979px) {
    .tunnel__viz { aspect-ratio: 4 / 3; max-height: none; }
    .tunnel__hint { display: none; }
    .tunnel__step { opacity: 1; }
  }

  /* Reduced motion must also drop the pin. Leaving it would make the
     visitor scroll three screens past a static picture to reach the next
     section — the cost of the effect with none of the effect. */
  @media (prefers-reduced-motion: reduce) {
    .tunnel { height: auto; }
    .tunnel__sticky { position: static; min-height: 0; }
    .tunnel__step { opacity: 1; }
    .tunnel__hint { display: none; }
  }
</style>

<script>
  for (const tunnel of document.querySelectorAll<HTMLElement>('[data-process-tunnel]')) {
    const steps = [...tunnel.querySelectorAll<HTMLElement>('.tunnel__step')];
    const fill = tunnel.querySelector<HTMLElement>('.tunnel__bar-fill');
    const pinned = () => window.matchMedia('(min-width: 980px)').matches;

    // Without the pin — narrow screens, reduced motion — every step reads at
    // full strength rather than waiting for a scroll that will not drive it.
    const showAll = () => steps.forEach((s) => s.toggleAttribute('data-on', true));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      showAll();
    } else {
      // The active step is read from whichever frame the zoom engine has
      // in focus, never recomputed here. One source of truth means the
      // words and the tunnel cannot drift apart.
      tunnel.addEventListener('droste:focus', (e) => {
        if (!pinned()) return;
        const i = (e as CustomEvent<{ index: number }>).detail.index % steps.length;
        steps.forEach((s, n) => s.toggleAttribute('data-on', n === i));
      });

      let queued = 0;
      const update = () => {
        queued = 0;
        if (!pinned()) return showAll();
        const r = tunnel.getBoundingClientRect();
        const travel = Math.max(1, tunnel.offsetHeight - window.innerHeight);
        const t = Math.min(1, Math.max(0, -r.top / travel));
        if (fill) fill.style.width = `${(t * 100).toFixed(1)}%`;
      };
      const schedule = () => { if (!queued) queued = requestAnimationFrame(update); };
      schedule();
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      window.matchMedia('(min-width: 980px)').addEventListener('change', (m) => {
        if (!m.matches) showAll();
      });
    }
  }
</script>
