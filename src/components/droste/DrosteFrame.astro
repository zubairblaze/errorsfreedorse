---
/**
 * The recursion primitive: a browser frame whose screen contains the
 * same browser frame, which contains the same browser frame, and so on.
 *
 * The component renders itself with depth-1 until depth reaches 0, so the
 * nesting is real composition rather than an exported image. Everything is
 * CSS transforms on live DOM: infinitely crisp, a few kilobytes, and
 * animatable per level.
 *
 * Depth is capped by the caller (5 on desktop, 3 on mobile). Below depth
 * 3 the copy is swapped for abstract bars — microtype is noise, not
 * detail, and dropping it keeps the composite cheap.
 */
import Logo from '../Logo.astro';

interface Props {
  /** Levels remaining below this one. 0 renders the innermost frame. */
  depth: number;
  /** Distance from the outermost frame, used for parallax weighting. */
  level?: number;
}
const { depth, level = 0 } = Astro.props;
const showCopy = level < 2;
---

<div class="frame" data-level={level} style={`--level:${level}`}>
  <div class="frame__chrome" aria-hidden={level > 0 ? 'true' : undefined}>
    <span class="frame__dot"></span><span class="frame__dot"></span><span class="frame__dot"></span>
    <span class="frame__url">errorsfree.com</span>
  </div>

  <div class="frame__screen">
    <div class="frame__copy">
      {showCopy ? (
        <>
          <Logo variant="mark" size={level === 0 ? 26 : 18} />
          <p class="frame__head">Build it right.<br />Then check it again.</p>
          <div class="frame__chips">
            <span class="frame__chip">Build</span>
            <span class="frame__chip">Test</span>
            <span class="frame__chip frame__chip--on">Verified</span>
          </div>
        </>
      ) : (
        <>
          <span class="frame__bar frame__bar--mark"></span>
          <span class="frame__bar frame__bar--wide"></span>
          <span class="frame__bar frame__bar--mid"></span>
        </>
      )}
    </div>

    {depth > 0 && <Astro.self depth={depth - 1} level={level + 1} />}
  </div>
</div>

<style>
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: clamp(8px, 1.6vw, 16px);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgb(var(--shadow) / 0.55);
  }

  /* --- Chrome ---------------------------------------------------- */
  .frame__chrome {
    display: flex; align-items: center; gap: 5px;
    padding: 0.55em 0.8em;
    background: var(--bg-3);
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  .frame__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--line-2); flex: none; }
  .frame__dot:first-child { background: rgb(var(--glow) / 0.85); }
  .frame__url {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: clamp(6px, 0.72vw, 10px);
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }

  /* --- Screen ---------------------------------------------------- */
  .frame__screen {
    position: relative;
    flex: 1;
    padding: clamp(0.7rem, 2.1vw, 1.9rem);
    background:
      radial-gradient(ellipse 70% 55% at 18% 12%, rgb(var(--glow) / 0.12), transparent 70%),
      var(--bg-2);
    min-height: 0;
  }

  .frame__copy { display: flex; flex-direction: column; gap: 0.55em; }
  .frame__head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.72rem, 1.55vw, 1.28rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
  }
  .frame__chips { display: flex; gap: 0.35em; flex-wrap: wrap; }
  .frame__chip {
    font-family: var(--font-mono);
    font-size: clamp(6px, 0.7vw, 9.5px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.32em 0.7em;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .frame__chip--on { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  /* Abstract stand-ins used below depth 2. */
  .frame__bar { display: block; height: 5px; border-radius: 3px; background: var(--line-2); }
  .frame__bar--mark { width: 14px; height: 14px; border-radius: 5px; background: var(--accent); }
  .frame__bar--wide { width: 72%; }
  .frame__bar--mid  { width: 46%; opacity: 0.6; }

  /* --- The recursion ---------------------------------------------
     Each nested frame occupies the lower-right of its parent's screen
     and twists a few degrees further, producing the spiral that reads
     as "this screen is showing itself".                              */
  .frame .frame {
    position: absolute;
    inset: 27% 4% 5% 25%;
    transform-origin: top left;
    transform:
      rotate(var(--droste-rotate))
      translate3d(
        calc(var(--px, 0) * (var(--level) + 1) * -3px),
        calc(var(--py, 0) * (var(--level) + 1) * -3px),
        0
      );
    transition: transform var(--dur-3) var(--ease-out);
    box-shadow: 0 12px 34px -18px rgb(var(--shadow) / 0.6);
  }

  /* Innermost level gets a faint accent bloom so the eye lands on the
     bottom of the well rather than trailing off. */
  .frame .frame .frame .frame {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgb(var(--glow) / 0.35), 0 0 34px -6px rgb(var(--glow) / 0.5);
  }

  @media (max-width: 720px) {
    .frame .frame { inset: 30% 3% 4% 28%; }
    .frame__chrome { padding: 0.45em 0.6em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame .frame { transform: rotate(var(--droste-rotate)); transition: none; }
  }
</style>
