---
/**
 * Line icons on a 24px grid, 1.6 stroke. Each service icon carries a
 * nested element so the recursion motif reaches even this scale.
 */
interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: className = '' } = Astro.props;
const p = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor',
  'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round',
  'aria-hidden': 'true', focusable: 'false', class: className } as const;
---
{name === 'app' && (
  <svg {...p}><rect x="3" y="2.5" width="18" height="19" rx="3"/><rect x="7" y="6.5" width="10" height="11" rx="1.8"/><rect x="10" y="10" width="4" height="4" rx="0.8"/></svg>
)}
{name === 'ai' && (
  <svg {...p}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>
)}
{name === 'saas' && (
  <svg {...p}><rect x="2.5" y="4" width="19" height="13" rx="2.5"/><rect x="6" y="7.5" width="12" height="6" rx="1.5"/><path d="M8 20.5h8"/></svg>
)}
{name === 'consult' && (
  <svg {...p}><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.4 8.4 0 1 1 21 11.5Z"/><path d="M9 11.5h6M9 8.5h3"/></svg>
)}
{name === 'arrow' && (
  <svg {...p} width={size} height={size}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
)}
{name === 'check' && (
  <svg {...p}><path d="M20 6.5 9.5 17 4 11.5"/></svg>
)}
{name === 'mail' && (
  <svg {...p}><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
)}
{name === 'phone' && (
  <svg {...p}><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/></svg>
)}
{name === 'whatsapp' && (
  <svg {...p}><path d="M3.5 20.5 5 16.4A8 8 0 1 1 8.2 19.5l-4.7 1Z"/><path d="M9 9.2c.4 2.3 2.5 4.4 4.8 4.8l1-1.3 1.7.8v1.2c0 .6-.5 1.1-1.1 1a7.6 7.6 0 0 1-6.9-6.9c-.1-.6.4-1.1 1-1.1h1.2l.8 1.7L9 9.2Z"/></svg>
)}
{name === 'pin' && (
  <svg {...p}><path d="M20 10.5c0 5.5-8 11-8 11s-8-5.5-8-11a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10.5" r="2.8"/></svg>
)}
{name === 'clock' && (
  <svg {...p}><circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/></svg>
)}
{name === 'palette' && (
  <svg {...p}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>
)}
{name === 'sun' && (
  <svg {...p}><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
)}
{name === 'moon' && (
  <svg {...p}><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
)}
{name === 'close' && (
  <svg {...p}><path d="m6 6 12 12M18 6 6 18"/></svg>
)}
{name === 'menu' && (
  <svg {...p}><path d="M3.5 7h17M3.5 12h17M3.5 17h17"/></svg>
)}
