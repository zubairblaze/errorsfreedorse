# Copy to .env and fill in. NEVER commit .env — it is gitignored, and this
# repository is public.
#
#   cp .env.example .env
#
# Rotate any credential that has been pasted into a chat window, an email or
# a ticket. Treat it as public from that moment.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=errdorste
DB_USER=errdorste
DB_PASS=

# Where the site is served from, with a trailing slash.
# XAMPP nested folder:  /errorsfree/
# Domain root:          /
APP_BASE=/

# 'production' hides error detail from visitors. Use 'development' locally.
APP_ENV=production

# Set to 1 once the site is served over HTTPS so cookies get the Secure flag.
# Leave 0 for plain-http localhost or the admin login will not persist.
APP_HTTPS=0

# Only used by bin/setup-admin.php when creating or resetting the account.
# Remove the value again once the account exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=
